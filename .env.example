# 복사해서 .env로 사용하세요: cp .env.example .env
# .env는 절대 커밋하지 마세요 (.gitignore에 포함됨)

ENVIRONMENT=local

# docker compose로 실행하면 아래 두 값은 compose 설정이 덮어씁니다
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scanner
REDIS_URL=redis://localhost:6379/0

# 프론트엔드 개발 서버 주소 (JSON 배열)
CORS_ORIGINS=["http://localhost:5173"]

# 프론트 서버와 같은 값을 넣으면 그 서버만 API 를 부를 수 있다 (openssl rand -base64 32). 비우면 검사하지 않음
BACKEND_API_KEY=

# GitHub: 비공개 레포 클론, 브랜치 푸시, PR 생성용 (repo 권한)
GITHUB_TOKEN=

# Claude API
ANTHROPIC_API_KEY=
LLM_TRIAGE_MODEL=claude-haiku-5-5
LLM_FIX_MODEL=claude-sonnet-5-5
LLM_MAX_CALLS_PER_SCAN=30
